<main class="page">
  <h1>ユーザー一覧</h1>
  <% if notice %><p class="notice"><%= notice %></p><% end %>
  <% if alert %><p class="alert"><%= alert %></p><% end %>

  <p><%= link_to "ユーザー登録", new_user_path %> | <%= link_to "つぶやき一覧へ", root_path %></p>
  <ul class="users">
    <% @users.each do |user| %>
      <li>
        <%= user.uid.presence || "未登録ユーザー (#{user.id})" %>
        <% if user.age.present? %>
          （<%= user.age %>歳）
        <% end %>
        <% if current_user&.id == user.id %>
          <%= link_to "プロフィール編集", edit_user_path(user) %>
          <%= button_to "アカウント削除", user_path(user), method: :delete,
                form: { data: { turbo_confirm: "アカウントと投稿を削除しますか？" } } %>
        <% end %>
      </li>
    <% end %>
  </ul>
</main>
